# Slothify Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Database Configuration (Free M0 Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/slothify?retryWrites=true&w=majority

# Security & Encryption Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
ENCRYPTION_SECRET=your_zero_knowledge_master_secret_here

# Optional APIs (e.g. Gemini for AI features if enabled)
GEMINI_API_KEY=your_gemini_api_key_here
