# Slothify Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection
# Replace <username> and <db_password> with your MongoDB user credentials
MONGODB_URI=mongodb+srv://<username>:<db_password>@cluster0.example.mongodb.net/slothify?retryWrites=true&w=majority

# Security Keys
JWT_SECRET=your_jwt_secret_key_change_in_production
ENCRYPTION_SECRET=your_zero_knowledge_master_secret_here